<Window x:Class="DesktopGremlin.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Width="340" MinHeight="140" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="14,10,14,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主卡片 -->
        <Border Grid.Row="0" Background="#FFF8FB" BorderBrush="#F2A7C3" BorderThickness="1.5"
                CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#E86A9B"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部：头像 + 名字 + 在线 + 关闭 -->
                <Border Grid.Row="0" Background="#FFEAF3" BorderBrush="#F9D3E3" BorderThickness="0,0,0,1"
                        CornerRadius="16,16,0,0" Padding="12,9" MouseLeftButtonDown="Header_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="30" Height="30" Margin="0,0,9,0">
                            <Ellipse x:Name="Avatar" Fill="#F4B8D3" Stroke="White" StrokeThickness="2"/>
                            <TextBlock x:Name="AvatarText" Text="马" FontSize="12" FontWeight="Medium" Foreground="#8A3D5E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" Text="马娘" FontSize="13" FontWeight="Medium" Foreground="#5A2C40"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" Fill="#7BD3A0" VerticalAlignment="Center"/>
                                <TextBlock Text="在线" FontSize="11" Foreground="#C4789B" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="ExpandButton" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                Background="White" BorderBrush="#F2A7C3" BorderThickness="1" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="展开/折叠历史对话"
                                MouseLeftButtonDown="ToggleArea_MouseDown"
                                MouseLeftButtonUp="Expand_Click">
                            <TextBlock x:Name="ExpandIcon" Text="▲" FontSize="7" Foreground="#C4789B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="3" Width="20" Height="20" CornerRadius="10"
                                Background="White" BorderBrush="#F2A7C3" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="Close_MouseDown"
                                MouseLeftButtonUp="Close_Click">
                            <TextBlock Text="✕" FontSize="10" Foreground="#C4789B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 消息区 -->
                <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                              Padding="12,10,12,2">
                    <StackPanel x:Name="MsgPanel"/>
                </ScrollViewer>

                <!-- 输入区 -->
                <Grid Grid.Row="2" Margin="12,6,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#F2A7C3" BorderThickness="1.5"
                            CornerRadius="16" Padding="12,6">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="说点什么…" FontSize="12"
                                       Foreground="#C4789B" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="Input" Background="Transparent" BorderThickness="0"
                                     FontSize="13" Foreground="#5A2C40" CaretBrush="#E86A9B"
                                     VerticalContentAlignment="Center" KeyDown="Input_KeyDown"
                                     TextChanged="Input_TextChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Width="52" Height="32" Margin="8,0,0,0" CornerRadius="16"
                            Background="#E86A9B" Cursor="Hand" MouseLeftButtonUp="Send_Click">
                        <TextBlock Text="发送" FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 指向桌宠的小尾巴 -->
        <Path Grid.Row="1" HorizontalAlignment="Center" Margin="0,-1,0,0"
              Data="M 0,0 L 18,0 L 9,10 Z" Fill="#F2A7C3"/>
    </Grid>
</Window>
